# Environment variable files
.env
.env.local
.env.development
.env.production
.env.test
*.env

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
*.ppk

# Cloud provider credentials
.aws/credentials
.aws/config
gcp-credentials.json
service-account.json

# Database config
database.yml
db_config.py
secrets.yml

# IDE and OS files
.DS_Store
Thumbs.db
.vscode/settings.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node.js
node_modules/
npm-debug.log

# Logs (may contain sensitive info)
*.log
logs/
